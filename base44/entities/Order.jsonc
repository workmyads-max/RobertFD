{
  "name": "Order",
  "type": "object",
  "permissions": {
    "read": "owner",
    "create": "authenticated",
    "update": "admin",
    "delete": "admin"
  },
  "properties": {
    "order_id": {
      "type": "string"
    },
    "challenge_type": {
      "type": "string",
      "enum": [
        "two-step",
        "instant",
        "instant_light"
      ]
    },
    "account_type": {
      "type": "string",
      "enum": [
        "swing",
        "standard"
      ]
    },
    "account_size": {
      "type": "number"
    },
    "platform": {
      "type": "string"
    },
    "leverage": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "usdt_trc20",
        "bitcoin",
        "checkout_com_card",
        "checkout_com_apple_pay",
        "checkout_com_google_pay",
        "confirmo_crypto",
        "nowpayments",
        "coinpayments"
      ]
    },
    "payment_gateway": {
      "type": "string",
      "enum": [
        "checkout_com",
        "confirmo",
        "manual"
      ],
      "default": "manual"
    },
    "payment_address": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "awaiting_confirmation",
        "authorized",
        "confirming",
        "confirmed",
        "paid",
        "failed",
        "expired",
        "cancelled",
        "refunded",
        "chargeback"
      ],
      "default": "pending"
    },
    "full_name": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "coupon_code": {
      "type": "string"
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "affiliate_code": {
      "type": "string"
    },
    "promo_applied": {
      "type": "boolean",
      "default": false,
      "description": "True when Buy 2 Get 1 Free promo is active on this order"
    },
    "promo_type": {
      "type": "string",
      "default": "",
      "description": "Promo identifier, e.g. buy2get1"
    },
    "promo_quantity": {
      "type": "number",
      "default": 1,
      "description": "Number of paid accounts in the bundle (2 for B2G1)"
    },
    "promo_free_account_size": {
      "type": "number",
      "default": 0,
      "description": "Size of the free promotional account (0 if no promo)"
    },
    "promo_free_account_provisioned": {
      "type": "boolean",
      "default": false,
      "description": "Whether the free promo account has been provisioned"
    }
  },
  "required": [
    "challenge_type",
    "account_size",
    "price"
  ]
}